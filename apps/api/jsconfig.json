{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2022",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@config/*": ["src/config/*"],
      "@models/*": ["src/models/*"],
      "@modules/*": ["src/modules/*"],
      "@utils/*": ["src/utils/*"],
      "@middleware/*": ["src/middleware/*"],
      "@db/*": ["src/db/*"],
      "@messages/*": ["src/messages/*"]
    },

    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,

    "lib": ["ES2022"],
    "types": ["node"],

    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/**/*", "src/**/*.json", "*.config.js"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".turbo",
    "coverage",
    "**/*.test.js",
    "**/*.spec.js"
  ],
  "typeAcquisition": {
    "enable": true,
    "include": ["node", "express", "mongoose", "jsonwebtoken"]
  }
}
